# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# --- Обязательное ---

# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Ключ OpenAI
OPENAI_API_KEY=

# Telegram ID администраторов через запятую.
# ВАЖНО: если оставить пустым, админские команды (/reindex, /reparse)
# доступны всем пользователям, а /reindex тратит деньги на эмбеддинги.
ADMIN_IDS=

# --- Модели ---

# Основная — чат и объяснения
LLM_MODEL=gpt-4.1
# Быстрая — проверка ответов, разбор ошибок
LLM_MODEL_MINI=gpt-4o-mini
# Векторизация текста, менять не нужно
EMBEDDING_MODEL=text-embedding-3-large

# --- Базовый контент предмета (Google) ---

# Путь к файлу сервисного аккаунта Google
GOOGLE_CREDENTIALS_PATH=credentials.json

# ID берётся из URL: docs.google.com/spreadsheets/d/ВОТЭТОТID/edit
TESTS_SHEET_ID=
FLASHCARDS_SHEET_ID=

# Имя листа с тестами (пусто = первый лист)
TESTS_WORKSHEET_NAME=
# Листы флеш-карточек
FLASH_DATES_WORKSHEET_NAME=Даты
FLASH_CONCEPTS_WORKSHEET_NAME=Понятия
FLASH_PERSONS_WORKSHEET_NAME=Личности

# Google Docs с материалами
TEXTBOOK_DOC_ID=
NOTES_DOC_ID=
THEORY_DOC_ID=

# --- Хранилище ---

VECTORSTORE_PATH=data/vectorstore/
HISTORY_CT_DB_PATH=data/history_ct.sqlite3
RAG_TOP_K=7
